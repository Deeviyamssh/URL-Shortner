# Environment variables for URL Shortener application.
# Copy this file to .env and replace placeholder values with real credentials.
# Never commit .env to version control.

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/urlshortener
SPRING_DATASOURCE_USERNAME=your-db-username
SPRING_DATASOURCE_PASSWORD=your-db-password

# Redis
SPRING_DATA_REDIS_HOST=your-redis-host
SPRING_DATA_REDIS_PORT=6379

# RabbitMQ
SPRING_RABBITMQ_HOST=your-rabbitmq-host
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=your-rabbitmq-username
SPRING_RABBITMQ_PASSWORD=your-rabbitmq-password

# Application
APP_BASE_URL=https://your-domain.com
SERVER_PORT=8080
